# SPDX-License-Identifier: MIT
[Unit]
Description=DHCP on DomD Wi-Fi after wpa_supplicant association
Requires=domd-wpa-supplicant.service
After=domd-wpa-supplicant.service
StartLimitIntervalSec=0

[Service]
TimeoutStartSec=infinity
ExecStartPre=/bin/sh -c 'while [ ! -S /run/wpa_supplicant/wlan0 ]; do sleep 0.5; done'
ExecStart=/usr/sbin/wpa_cli -p /run/wpa_supplicant -i wlan0 -a /usr/libexec/domd-wifi-dhcp-action
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
